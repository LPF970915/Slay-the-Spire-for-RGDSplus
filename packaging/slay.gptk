# RGDSplus buttons use the Balatro SDL mapping in rgds-gamecontroller.txt.
select = m
start = tab
a = space
b = esc
x = x
y = enter
l1 = q
l2 = a
r1 = e
r2 = r
up = up
down = down
left = left
right = right
left_analog_up = up
left_analog_down = down
left_analog_left = left
left_analog_right = right
deadzone_mode = scaled_radial
deadzone = 2000
deadzone_scale = 8
deadzone_delay = 16
